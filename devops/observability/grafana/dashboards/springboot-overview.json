{
  "title": "Spring Boot Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "targets": [
        {"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"agence-.*\",pod=~\".*backend.*\"}[5m])) by (pod)", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "targets": [
        {"expr": "sum(container_memory_working_set_bytes{namespace=~\"agence-.*\",pod=~\".*backend.*\"}) by (pod)", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count[1m]))", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx",
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
